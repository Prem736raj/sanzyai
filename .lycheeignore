# Lychee ignore list for SanzyAI

# Mailto links
^mailto:

# Root-relative paths and file URIs (internal routes strictly validated by npm run check:routes)
^file:
^/
^/[^/]

# Live production domain (unregistered/NXDOMAIN in public DNS)
^https?://(www\.)?sanzyai\.com

# Generated build artifacts and dependencies
^dist/
^node_modules/
^artifacts/

# External platforms with strict bot blocking / anti-scraping challenges in CI
^https?://(www\.)?x\.com
^https?://(www\.)?twitter\.com
^https?://(www\.)?instagram\.com
^https?://(www\.)?linkedin\.com
^https?://(www\.)?customers\.gumroad\.com
