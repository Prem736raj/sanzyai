# Server-side only. Never expose this in frontend files.
GROQ_API_KEY=replace_with_new_key

# Optional: defaults to llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant

# Optional local backend port
PORT=8787

# Optional: comma-separated CORS allowlist (production should include your domain only)
# Example: https://sanzyai.com,https://www.sanzyai.com
CORS_ALLOW_ORIGINS=

# Optional: API rate limiting and payload constraints
RATE_LIMIT_GLOBAL_LIMIT=180
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_CHAT_LIMIT=15
RATE_LIMIT_CHAT_WINDOW_MS=60000
RATE_LIMIT_NEWS_LIMIT=40
RATE_LIMIT_NEWS_WINDOW_MS=300000
MAX_CHAT_BODY_BYTES=12000
MAX_DEFAULT_BODY_BYTES=25000

# Optional: AI news freshness/cache control
AI_NEWS_CACHE_TTL_MS=180000

# Local bind address. For production behind a reverse proxy, set HOST=0.0.0.0.
HOST=127.0.0.1
# Exact IP addresses of trusted reverse proxies, comma-separated. Empty ignores X-Forwarded-For.
TRUSTED_PROXY_IPS=
# Single-process AI call ceiling and concurrency. Also set a provider-side spending limit.
CHAT_DAILY_REQUEST_LIMIT=500
CHAT_MAX_CONCURRENT=4
MAX_NEWS_ITEMS=100

# Server-only HTTPS receivers. A 2xx response must mean the submission was accepted.
# Keep webhook credentials out of VITE_* variables and frontend JavaScript.
LEAD_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
# Optional public GA4 measurement ID; analytics loads only after consent.
VITE_GA_ID=
